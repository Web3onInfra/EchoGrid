# ── EchoGrid Oracle Environment Variables ──────────────────────────────────
# Copy this to .env and fill in real values for live-network mode.
# The oracle runs fine without these in mock mode (the default).

# Oracle's Stellar secret key — NEVER commit the real key!
ORACLE_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Deployed NegaWattEscrow contract ID on Testnet.
CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# USDC-T SAC contract ID on Testnet.
TOKEN_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Horizon REST endpoint.
HORIZON_URL=https://horizon-testnet.stellar.org

# HTTP port for the oracle server (default: 8080).
PORT=8080

# Log level — trace | debug | info | warn | error
RUST_LOG=info
