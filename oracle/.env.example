# ── EchoGrid Oracle Environment Variables ──────────────────────────────────
# The oracle defaults to safe offline mock mode (ORACLE_MODE=mock).
# In live mode (ORACLE_MODE=live), all Stellar keys and IDs are required.

# Operational mode: mock | live (default: mock)
ORACLE_MODE=mock

# Server binding
HOST=0.0.0.0
PORT=8080

# Logging level: trace | debug | info | warn | error
RUST_LOG=info

# SQLite persistent database path (default: echogrid.db)
DATABASE_URL=echogrid.db

# Allowed CORS origins (comma-separated; default: * in dev/mock)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Stellar / Soroban Network Configuration (Required for live mode) ────────
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Deployed NegaWattEscrow smart contract ID (Testnet C... address)
CONTRACT_ID=CDFOK4NF4CY27N4G5PYA6SXTJA5MEKPVU7DQRMJUS74LIXHOKYNRHOPF

# Deployed USDC / Token SAC contract ID (Testnet C... address)
TOKEN_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Oracle Hot Keypair Secret (S... address) — NEVER COMMIT OR LOG THIS VALUE
ORACLE_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Operational Limits & Economic Bounds ─────────────────────────────────────
CHALLENGE_TTL_SECONDS=120
COOLDOWN_SECONDS=600
WALLET_DAILY_CLAIM_LIMIT=2
ORACLE_DAILY_CAP_STROOPS=100000000
BOUNTY_STROOPS=10000000
RATE_LIMIT_PER_MIN=30
CHALLENGE_RATE_PER_MIN=6
SYNC_WAIT_TIMEOUT_SECONDS=20
REQUEST_TIMEOUT_SECONDS=30
TRUST_PROXY=false
