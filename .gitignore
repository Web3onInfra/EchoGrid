# Build artifacts
/target
**/target
**/*.rs.bk
node_modules/
**/node_modules/
dist/
**/dist/
.venv/
__pycache__/
*.py[cod]
*$py.class

# Raw data and audio recordings (Phase 0 rule: Never commit raw audio)
data/*
!data/MANIFEST.md
*.wav
*.mp3
*.flac
*.ogg

# Environment variables and secrets (Never commit secrets)
.env
*.env
.env.*
!.env.example

# IDE & Editor files
*.swp
*~
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local database files
*.db
*.db-shm
*.db-wal
